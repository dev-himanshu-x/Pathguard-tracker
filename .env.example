# Copy to .env and fill in. Free option: a Gmail account with an App Password
# (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="PathGuard <you@gmail.com>"
# Leave SMTP_* empty to use a throwaway Ethereal test inbox (nothing is delivered).

# SMS + WhatsApp via Twilio (free trial credit; WhatsApp has a free sandbox):
# https://console.twilio.com  ->  Account SID + Auth Token
# Trial accounts can only message numbers you have verified in Twilio.
# WhatsApp sandbox: each guardian must first send the join code to the sandbox number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+1xxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
